{
  "name": "QingJiAI",
  "version": "1.0.7",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "android:assemble:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/android-build-windows.ps1 -Offline",
    "android:assemble:internal:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/android-build-windows.ps1 -Variant Internal -Offline",
    "android:assemble:streaming-asr:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/android-build-windows.ps1 -Variant Internal -StreamingAsr -Offline",
    "android:assemble:release:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/android-build-windows.ps1 -Variant Release -Offline",
    "asr:benchmark:score": "node scripts/asr-benchmark/score-asr-ab.cjs",
    "asr:benchmark:test": "node --test scripts/asr-benchmark/score-asr-ab.test.cjs",
    "android:streaming-asr:prepare:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-android-streaming-asr.ps1",
    "android:streaming-asr:verify:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-android-streaming-asr.ps1 -VerifyOnly",
    "android:install:internal:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/android-install-internal-windows.ps1",
    "android:install:test:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/android-install-internal-windows.test.ps1",
    "android:regression:device:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/android-device-regression.ps1 -Launch",
    "android:verify:internal:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/android-build-windows.ps1 -Variant Internal -RunUnitTests -Offline",
    "android:verify:streaming-asr:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/android-build-windows.ps1 -Variant Internal -StreamingAsr -RunUnitTests -Offline",
    "android:verify:release:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/android-build-windows.ps1 -Variant Release -RunUnitTests -Offline",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "migration:integrity:check": "node scripts/verify-migration-integrity.cjs",
    "migration:integrity:test": "node --test scripts/verify-migration-integrity.test.cjs",
    "repository:hygiene": "node scripts/verify-repository-hygiene.cjs",
    "release:identity:check": "node scripts/verify-release-identity.cjs",
    "release:identity:test": "node --test scripts/verify-release-identity.test.cjs",
    "start": "react-native start",
    "test": "jest",
    "test:ci": "jest --runInBand",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@op-engineering/op-sqlite": "17.1.2",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-vector-icons/material-design-icons": "13.1.2",
    "@react-navigation/bottom-tabs": "7.18.11",
    "@react-navigation/native": "7.3.11",
    "@react-navigation/native-stack": "7.18.3",
    "fflate": "0.8.3",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.26.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.0",
    "@react-native/eslint-config": "0.86.0",
    "@react-native/jest-preset": "0.86.0",
    "@react-native/metro-config": "0.86.0",
    "@react-native/typescript-config": "0.86.0",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "^29.5.13",
    "@types/node": "26.1.1",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "better-sqlite3": "12.5.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "3.9.5",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "packageManager": "pnpm@11.9.0"
}
