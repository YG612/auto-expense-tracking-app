# Local APK/AAB archives are reproducible build outputs, not source files.
/artifacts/
/outputs/

# Reproducible, locally generated synthetic corpora and prepared splits.
# Keep schemas/prompts/generators in git; do not commit bulk generated rows.
/data/synthetic/reviewed/
/data/synthetic/prepared/
/data/synthetic/work/

# Codex-managed local worktrees are machine-local and may contain large build assets.
/.codex-worktrees/

# Ruby / CocoaPods
**/Pods/
/vendor/bundle/

# Temporary files created by Metro to check the health of the file watcher
.metro-health-check*

# Local device-test screenshots, UI dumps, Metro logs, and build scratch data.
/tmp/

# testing
/coverage

# Yarn
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
