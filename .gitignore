# fastlane
#
# It is recommended to not store the screenshots in the git repo. Instead, use fastlane to re-generate the
# screenshots whenever they are needed.
# For more information about the recommended setup visit:
# https://docs.fastlane.tools/best-practices/source-control/

**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/screenshots
**/fastlane/test_output

# Bundle artifact
*.jsbundle

# Internal-only streaming ASR payload. It is present only after the explicit,
# hash-verified preparation step and must never enter ordinary app packages.
/android/app/src/streamingAsr/libs/*.aar
/android/app/src/streamingAsr/assets/speech/zipformer-zh-14m/*.bin
/android/app/src/streamingAsr/assets/speech/zipformer-zh-14m/*.param
/android/app/src/streamingAsr/assets/speech/zipformer-zh-14m/tokens.txt
/android/app/src/streamingAsr/assets/speech/zipformer-zh-14m/prepared-assets.json
/android/app/src/streamingAsr/assets/speech/zipformer-zh-14m/SHERPA_NCNN_APACHE-2.0.txt
/android/app/src/streamingAsr/assets/speech/zipformer-zh-14m/ncnn-LICENSE.txt
/android/app/src/streamingAsr/assets/speech/zipformer-zh-14m/streaming-asr-sbom.json

# Local APK/AAB archives are reproducible build outputs, not source files.
/artifacts/

# Ruby / CocoaPods
**/Pods/
/vendor/bundle/

# Temporary files created by Metro to check the health of the file watcher
.metro-health-check*

# testing
/coverage

