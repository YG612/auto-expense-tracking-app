# Local environment values. Never commit secrets.
.env
.env.*
!.env.example

# fastlane
#
# It is recommended to not store the screenshots in the git repo. Instead, use fastlane to re-generate the
# screenshots whenever they are needed.
# For more information about the recommended setup visit:
# https://docs.fastlane.tools/best-practices/source-control/

**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/screenshots
**/fastlane/test_output

# Bundle artifact
*.jsbundle

# Internal-only streaming ASR payload. It is present only after the explicit,
# hash-verified preparation step and must never enter ordinary app packages.
/android/app/src/streamingAsr/libs/*.aar
/android/app/src/streamingAsr/assets/speech/zipformer-zh-14m/*.bin
/android/app/src/streamingAsr/assets/speech/zipformer-zh-14m/*.param
/android/app/src/streamingAsr/assets/speech/zipformer-zh-14m/tokens.txt
/android/app/src/streamingAsr/assets/speech/zipformer-zh-14m/prepared-assets.json
/android/app/src/streamingAsr/assets/speech/zipformer-zh-14m/SHERPA_NCNN_APACHE-2.0.txt
/android/app/src/streamingAsr/assets/speech/zipformer-zh-14m/ncnn-LICENSE.txt
/android/app/src/streamingAsr/assets/speech/zipformer-zh-14m/streaming-asr-sbom.json
/android/app/src/streamingOnnx/libs/*.aar
/android/app/src/streamingOnnx/assets/speech/zipformer-zh-14m-onnx/*.onnx
/android/app/src/streamingOnnx/assets/speech/zipformer-zh-14m-onnx/tokens.txt
/android/app/src/streamingOnnx/assets/speech/zipformer-zh-14m-onnx/prepared-assets.json
/android/app/src/streamingOnnxCtcSmall/libs/*.aar
/android/app/src/streamingOnnxCtcSmall/assets/speech/zipformer-small-ctc-zh-int8-2025-04-01/*.onnx
/android/app/src/streamingOnnxCtcSmall/assets/speech/zipformer-small-ctc-zh-int8-2025-04-01/*.model
/android/app/src/streamingOnnxCtcSmall/assets/speech/zipformer-small-ctc-zh-int8-2025-04-01/*.txt
/android/app/src/streamingOnnxCtcSmall/assets/speech/zipformer-small-ctc-zh-int8-2025-04-01/*.json
/android/app/src/streamingOnnxParaformerSmall/libs/*.aar
/android/app/src/streamingOnnxParaformerSmall/assets/speech/paraformer-zh-small-int8-2024-03-09/*.onnx
/android/app/src/streamingOnnxParaformerSmall/assets/speech/paraformer-zh-small-int8-2024-03-09/*.txt
/android/app/src/streamingOnnxParaformerSmall/assets/speech/paraformer-zh-small-int8-2024-03-09/*.json
/android/app/src/streamingOnnxParaformerCompact/libs/*.aar
/android/app/src/streamingOnnxParaformerCompact/assets/speech/paraformer-zh-compact/*.onnx
/android/app/src/streamingOnnxParaformerCompact/assets/speech/paraformer-zh-compact/*.qgz
